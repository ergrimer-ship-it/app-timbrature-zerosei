{
    "firestore": {
        "rules": "firestore.rules"
    },
    "functions": {
        "source": "functions",
        "runtime": "nodejs22"
    },
    "hosting": {
        "public": "dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "rewrites": [{ "source": "**", "destination": "/index.html" }],
        "headers": [
            { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
        ]
    }
}
